# Copy to `terraform.env` (gitignored) and fill in. Every script in infra/scripts/
# sources it and fails loudly if it's missing.
#
# This replaces terraform.tfvars entirely — two competing config surfaces for the same
# values is how they drift apart. Nothing here is committed with a real value.

# ---------------------------------------------------------------------------
# AWS identities
# ---------------------------------------------------------------------------

# Profile holding the account ROOT keys. Used by bootstrap.sh exactly once, to create
# the IAM user below, and then never again. Delete the root access keys in the AWS
# Console once AWS_PROFILE works — Terraform cannot delete the keys it is authenticating
# with, so that step is yours.
export BOOTSTRAP_AWS_PROFILE="helpdesk-eks"

# Profile that bootstrap.sh WRITES, holding the terraform-eks-admin IAM user's keys.
# Every deploy/destroy after bootstrap runs as this. Kept separate from the bootstrap
# profile so a failed bootstrap never leaves the machine with no working credentials.
export AWS_PROFILE="helpdesk-eks-tf"
export AWS_REGION="us-east-1"

# ---------------------------------------------------------------------------
# Terraform variables (TF_VAR_* are picked up automatically)
# ---------------------------------------------------------------------------

export TF_VAR_github_repository="iam-adnan/helpdesk"

# Slack Incoming Webhook. Powers three separate senders, all to the same channel:
#   1. infra/scripts/*.sh deploy/destroy notifications (this file)
#   2. Alertmanager runtime alerts     (synced via AWS Secrets Manager)
#   3. The GitHub Actions pipeline     (the SLACK_WEBHOOK_URL repo secret)
# Set the same value in all three. Left empty, the scripts warn and carry on rather
# than failing a deploy over a notification.
export TF_VAR_slack_webhook_url=""

# 1 = one Elastic IP, one static address (default, cheapest, single AZ).
# 2 = two Elastic IPs and an HA load balancer, ~$0.005/hr more.
export TF_VAR_nlb_az_count="1"

# Set once a real domain points at the static IP; until then the raw IP is used for
# CORS origins and Grafana's root_url.
export TF_VAR_site_domain=""

# ---------------------------------------------------------------------------
# Optional — only needed if the Docker Hub repos are private
# ---------------------------------------------------------------------------

export TF_VAR_dockerhub_username=""
export TF_VAR_dockerhub_token=""
