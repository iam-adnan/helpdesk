# Copy to terraform.tfvars (gitignored — never commit real values) and fill in,
# or pass every value as TF_VAR_<name> environment variables instead (better for
# a shared/CI context, since nothing then touches disk in plaintext at all).

aws_region         = "us-east-1"
cluster_name       = "helpdesk-eks"
github_repository  = "iam-adnan/helpdesk"
enable_nat_gateway = false # true only when deliberately practicing the "production-pattern" networking

# Only needed if the Docker Hub repos are private:
# dockerhub_username = "your-dockerhub-username"
# dockerhub_token    = "your-dockerhub-access-token"

# Slack Incoming Webhook — same value as `gh secret set SLACK_WEBHOOK_URL`. Powers
# Alertmanager's runtime-failure notifications (pod crash loops, node not ready,
# high resource usage). Leave unset and Alertmanager just won't have anywhere to
# send alerts until this is filled in.
# slack_webhook_url = "https://hooks.slack.com/services/XXX/YYY/ZZZ"

# Update after first apply, once `kubectl -n helpdesk get ingress helpdesk-ingress`
# has a real ALB hostname (or once a real domain is in front of it):
# grafana_domain = "<alb-hostname-or-real-domain>"
