{
  "display_information": {
    "name": "Helpdesk Automation",
    "description": "Ticket creation from Slack + CI/CD and monitoring notifications for the Mindstorm Helpdesk app",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Helpdesk Bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/helpdesk",
        "description": "Create a helpdesk ticket",
        "usage_hint": "",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "users:read",
        "commands",
        "incoming-webhook"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
