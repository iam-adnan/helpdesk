.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is intentionally NOT ignored — it pins exact provider
# versions/checksums and should be committed for reproducibility, same as a
# package-lock.json.
tfplan
*.tfplan

# Terraform/AWS config and secrets — the single config surface, replacing terraform.tfvars.
# Holds the Slack webhook and (optionally) Docker Hub credentials in plaintext.
terraform.env
!terraform.env.example

# Python
__pycache__/
*.pyc
backend/data/
backend/staticfiles/
backend/media/
*.sqlite3
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
frontend/.next/
frontend/coverage/
frontend/next-env.d.ts

# Env
.env
.env.local
.env.*.local

# Claude Code personal settings (permission allowlist for the infra scripts) — personal
# to one machine, not a team-wide policy, so it stays out of the repo.
.claude/settings.local.json
